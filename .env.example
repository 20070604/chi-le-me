# Server-only unified AI gateway. Never place the provider key in a VITE_* variable.
# Text, vision, recipe search and advisor requests all use this provider and model.
ADVISOR_BASE_URL=https://uuapi.net/v1
ADVISOR_API_KEY=
ADVISOR_MODEL=gpt-5.5-mini

# Leave empty for the same-origin /api routes. Set only when the backend uses another origin.
VITE_AI_API_URL=
