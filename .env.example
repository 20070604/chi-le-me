# Server-only gateway credentials. Never place a provider key in a VITE_* variable.
OPENAI_NEXT_BASE_URL=https://api.openai-next.com/v1
OPENAI_NEXT_API_KEY=replace-with-a-new-rotated-key

# Fast first, accurate fallback. All slugs can be replaced by models available on the gateway.
AI_TEXT_MODEL=gpt-5.4-mini
AI_VISION_MODEL=gpt-5.4-mini
AI_FALLBACK_MODEL=gpt-5.6-terra
AI_CHAT_FAST_MODEL=deepseek-v4-flash
AI_CHAT_BALANCED_MODEL=qwen3.5-plus
AI_CHAT_DEEP_MODEL=gpt-5.6-terra

# Leave empty for the same-origin /api routes. Set only when the backend uses another origin.
VITE_AI_API_URL=
